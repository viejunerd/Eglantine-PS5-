+// Native-texture handle offsets in cbuf0 before the shader's first unconditional EXIT.
+std::pair<std::vector<u32>, std::vector<u32>> KeplerCompute::NativeImageHandles(GPUVAddr program) {
+    static std::unordered_map<GPUVAddr, std::pair<std::vector<u32>, std::vector<u32>>> cache;
+    if (const auto found = cache.find(program); found != cache.end()) return found->second;
+    std::pair<std::vector<u32>, std::vector<u32>> handles;
+    const auto add = [](std::vector<u32>& values, u32 value) {
+        if (std::find(values.begin(), values.end(), value) == values.end()) values.push_back(value);
+    };
+    std::array<u32, 0x400> block{};
+    bool exited = false;
+    for (u64 offset = 0; offset < 0x40000 && !exited; offset += sizeof(block)) {
+        if (!memory_manager.IsFullyMappedRange(program + offset, sizeof(block))) break;
+        memory_manager.ReadBlock(program + offset, block.data(), sizeof(block));
+        for (size_t word = 0; word < block.size() && !exited; word += 4) {
+            const u32 opcode = block[word] & 0xfff;
+            const u32 binding = (block[word + 1] >> 22) & 0x1f;
+            const u32 handle = ((block[word + 1] >> 8) & 0x3fff) * 4;
+            switch (opcode) {
+            case 0xb60: case 0xb63: case 0xb66: case 0xb6d:
+                if (binding == 0) add(handles.first, handle);
+                break;
+            case 0xb9b:
+                if (binding == 0) add(handles.second, handle);
+                break;
+            case 0x94d:
+                exited = ((block[word] >> 12) & 0xf) == 7;
+                break;
+            default: break;
+            }
+        }
+    }
+    return cache.emplace(program, std::move(handles)).first->second;
+}
+
+// A stand-in only for native programs that read an E5B9G9R9 source and store a larger image.
+// Reject unrelated image bindings rather than guessing an arbitrary pair.
+bool KeplerCompute::TryOcarinaUpscale() {
+    if (!(launch_description.const_buffer_enable_mask & 1)) return false;
+    const auto& cbuf = launch_description.const_buffer_config[0];
+    const GPUVAddr address = cbuf.Address();
+    if (address == 0 || cbuf.size.Value() == 0) return false;
+    const auto image = [&](u32 offset) -> std::optional<Texture::TICEntry> {
+        if (offset + sizeof(u32) > cbuf.size.Value() ||
+            !memory_manager.IsFullyMappedRange(address + offset, sizeof(u32))) return std::nullopt;
+        const u32 handle = memory_manager.Read<u32>(address + offset);
+        if (handle == 0) return std::nullopt;
+        const u32 index = handle & 0xfffff;
+        const GPUVAddr tic = regs.tic.Address() + u64{index} * sizeof(Texture::TICEntry);
+        if (index > regs.tic.limit ||
+            !memory_manager.IsFullyMappedRange(tic, sizeof(Texture::TICEntry))) return std::nullopt;
+        return GetTICEntry(index);
+    };
+    const auto [reads, stores] =
+        NativeImageHandles(regs.code_loc.Address() + launch_description.program_start);
+    std::optional<Texture::TICEntry> input, output;
+    for (const u32 store : stores) {
+        const auto to = image(store);
+        if (!to || to->Address() == 0 || !to->IsBlockLinear()) continue;
+        for (const u32 read : reads) {
+            const auto from = image(read);
+            if (!from || from->format != Texture::TextureFormat::E5B9G9R9 ||
+                from->Address() == 0 || !from->IsBlockLinear() || from->Address() == to->Address() ||
+                from->Width() < 64 || from->Height() == 0 ||
+                to->Width() <= from->Width() || to->Height() <= from->Height() ||
+                u64{to->Width()} > u64{from->Width()} * 4 ||
+                u64{to->Height()} > u64{from->Height()} * 4) continue;
+            const u64 lhs = u64{to->Width()} * from->Height();
+            const u64 rhs = u64{to->Height()} * from->Width();
+            if ((lhs > rhs ? lhs - rhs : rhs - lhs) * 32 > lhs) continue;
+            if (!input || u64{from->Width()} * from->Height() >
+                              u64{input->Width()} * input->Height()) {
+                input = from;
+                output = to;
+            }
+        }
+    }
+    if (!input || !output) return false;
+    using RTFormat = Tegra::RenderTargetFormat;
+    const auto output_format = [](const Texture::TICEntry& tic) -> std::optional<RTFormat> {
+        switch (tic.format) {
+        case Texture::TextureFormat::A2B10G10R10: return RTFormat::A2B10G10R10_UNORM;
+        case Texture::TextureFormat::A8B8G8R8: return RTFormat::A8B8G8R8_UNORM;
+        case Texture::TextureFormat::B10G11R11: return RTFormat::B10G11R11_FLOAT;
+        case Texture::TextureFormat::R16G16B16A16: return RTFormat::R16G16B16A16_FLOAT;
+        default: return std::nullopt;
+        }
+    }(*output);
+    if (!output_format) return false;
+    const auto surface = [](const Texture::TICEntry& tic, RTFormat fmt) {
+        Fermi2D::Surface result{};
+        result.format = fmt;
+        result.linear = Fermi2D::MemoryLayout::BlockLinear;
+        result.block_width.Assign(tic.block_width);
+        result.block_height.Assign(tic.block_height);
+        result.block_depth.Assign(tic.block_depth);
+        result.depth = 1;
+        result.width = tic.Width();
+        result.height = tic.Height();
+        result.addr_upper = static_cast<u32>(tic.Address() >> 32);
+        result.addr_lower = static_cast<u32>(tic.Address());
+        return result;
+    };
+    const Fermi2D::Config config{
+        .operation = Fermi2D::Operation::SrcCopy,
+        .filter = Fermi2D::Filter::Bilinear,
+        .must_accelerate = true,
+        .dst_x0 = 0, .dst_y0 = 0,
+        .dst_x1 = static_cast<s32>(output->Width()),
+        .dst_y1 = static_cast<s32>(output->Height()),
+        .src_x0 = 0, .src_y0 = 0,
+        .src_x1 = static_cast<s32>(input->Width()),
+        .src_y1 = static_cast<s32>(input->Height()),
+    };
+    VideoCommon::g_blit_source_format = VideoCore::Surface::PixelFormat::E5B9G9R9_FLOAT;
+    SCOPE_EXIT { VideoCommon::g_blit_source_format.reset(); };
+    const bool done = rasterizer->AccelerateSurfaceCopy(
+        surface(*input, RTFormat::B10G11R11_FLOAT), surface(*output, *output_format), config);
+    static u32 reported{};
+    if (reported++ < 8) {
+        LOG_INFO(HW_GPU, "Ocarina shared-exponent upscale {}x{} -> {}x{}: {}",
+                 input->Width(), input->Height(), output->Width(), output->Height(),
+                 done ? "blit" : "unavailable");
+    }
+    return done;
+}
