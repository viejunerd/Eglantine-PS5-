+// Donkey Kong Bananza's rejected tensor upscaler consumes the image handle at cbuf0+0x60
+// and writes the larger image at +0x70. The old generic handle-scan stand-in was removed
+// upstream; use only this verified slot pair, without guessing from stale handles.
+bool KeplerCompute::TryBananzaUpscale() {
+    if (!(launch_description.const_buffer_enable_mask & 1)) {
+        return false;
+    }
+    const auto& cbuf = launch_description.const_buffer_config[0];
+    const GPUVAddr address = cbuf.Address();
+    if (cbuf.size.Value() < 0x74 ||
+        !memory_manager.IsFullyMappedRange(address, 0x74)) {
+        return false;
+    }
+    const auto image = [&](u32 offset) -> std::optional<Texture::TICEntry> {
+        const u32 handle = memory_manager.Read<u32>(address + offset);
+        if (handle == 0) {
+            return std::nullopt;
+        }
+        const u32 index = handle & 0xfffff;
+        const GPUVAddr tic = regs.tic.Address() + u64{index} * sizeof(Texture::TICEntry);
+        if (index > regs.tic.limit ||
+            !memory_manager.IsFullyMappedRange(tic, sizeof(Texture::TICEntry))) {
+            return std::nullopt;
+        }
+        return GetTICEntry(index);
+    };
+    const auto input = image(0x60);
+    const auto output = image(0x70);
+    if (!input || !output ||
+        input->format != Texture::TextureFormat::B10G11R11 ||
+        output->format != input->format ||
+        input->Address() == 0 || output->Address() == 0 ||
+        !input->IsBlockLinear() || !output->IsBlockLinear() ||
+        input->Width() == 0 || input->Height() == 0 ||
+        output->Width() <= input->Width() || output->Height() <= input->Height()) {
+        return false;
+    }
+    const auto surface = [](const Texture::TICEntry& tic) {
+        Fermi2D::Surface result{};
+        result.format = Tegra::RenderTargetFormat::B10G11R11_FLOAT;
+        result.linear = Fermi2D::MemoryLayout::BlockLinear;
+        result.block_width.Assign(tic.block_width);
+        result.block_height.Assign(tic.block_height);
+        result.block_depth.Assign(tic.block_depth);
+        result.depth = 1;
+        result.width = tic.Width();
+        result.height = tic.Height();
+        result.addr_upper = static_cast<u32>(tic.Address() >> 32);
+        result.addr_lower = static_cast<u32>(tic.Address());
+        return result;
+    };
+    const Fermi2D::Config config{
+        .operation = Fermi2D::Operation::SrcCopy,
+        .filter = Fermi2D::Filter::Bilinear,
+        .must_accelerate = true,
+        .dst_x0 = 0,
+        .dst_y0 = 0,
+        .dst_x1 = static_cast<s32>(output->Width()),
+        .dst_y1 = static_cast<s32>(output->Height()),
+        .src_x0 = 0,
+        .src_y0 = 0,
+        .src_x1 = static_cast<s32>(input->Width()),
+        .src_y1 = static_cast<s32>(input->Height()),
+    };
+    const bool done = rasterizer->AccelerateSurfaceCopy(surface(*input), surface(*output), config);
+    static u32 reported{};
+    if (reported++ < 8) {
+        LOG_INFO(HW_GPU, "Bananza tensor upscale stand-in: {}x{} -> {}x{}: {}",
+                 input->Width(), input->Height(), output->Width(), output->Height(),
+                 done ? "blitted" : "unavailable");
+    }
+    return done;
+}
